{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.hogehoge.deck-rx",
  "Name": "Deck RX",
  "Version": "0.1.0.1",
  "Author": "hogehoge",
  "Description": "SDR receiver controller for Stream Deck (AM / SW / FM via SpyServer).",
  "Category": "Deck RX",
  "CategoryIcon": "imgs/category-icon",
  "CodePath": "bin/index.js",
  "Icon": "imgs/category-icon",
  "Actions": [
    {
      "UUID": "com.hogehoge.deck-rx.tune",
      "Name": "Deck RX Tune",
      "Icon": "imgs/actions/tune/action",
      "Tooltip": "Tune to a preset frequency",
      "PropertyInspectorPath": "ui/tune/inspector.html",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/tune/action", "Title": "" }]
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-tune",
      "Name": "Deck RX Dial",
      "Icon": "imgs/actions/tune/action",
      "Tooltip": "VFO / preset tuning dial",
      "PropertyInspectorPath": "ui/dial-tune/inspector.html",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/tune/action", "Title": "VFO" }],
      "Encoder": {
        "layout": "layouts/dial-tune.json",
        "TriggerDescription": { "Rotate": "Tune frequency", "Push": "", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-options",
      "Name": "Deck RX Options",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "FM demodulation options",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "Opts" }],
      "Encoder": {
        "layout": "layouts/dial-options.json",
        "TriggerDescription": { "Rotate": "Navigate / Adjust", "Push": "Toggle edit", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-am-options",
      "Name": "Deck RX AM Options",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "AM bandwidth and Carrier AGC settings",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "AM" }],
      "Encoder": {
        "layout": "layouts/dial-am-options.json",
        "TriggerDescription": { "Rotate": "Navigate / Adjust", "Push": "Toggle edit", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-options-combo",
      "Name": "Deck RX Combo Options",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "Band selector (WFM/NFM/AM/USB/LSB/CW) + mode-dependent options on a single dial",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "Opts" }],
      "Encoder": {
        "layout": "layouts/dial-options-combo.json",
        "TriggerDescription": { "Rotate": "Navigate / Adjust", "Push": "Confirm band / Toggle edit", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-band-select",
      "Name": "Deck RX Band Select",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "Band selector — full-width WFM/NFM/AM/USB/LSB/CW + Mode/Step",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "Band" }],
      "Encoder": {
        "layout": "layouts/dial-band-select.json",
        "TriggerDescription": { "Rotate": "Cycle band", "Push": "Confirm band / Toggle Mode/Step edit", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-options-auto",
      "Name": "Deck RX Options Auto",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "Mode-aware Options (AM/FM/SSB) auto-shape on one full-width dial",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "Opts" }],
      "Encoder": {
        "layout": "layouts/dial-options-auto.json",
        "TriggerDescription": { "Rotate": "Navigate / Adjust", "Push": "Toggle edit", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-options-2col",
      "Name": "Deck RX Options 2-Col",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "AM | FM 2-column Options panel; SSB collapses to a single column",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "2col" }],
      "Encoder": {
        "layout": "layouts/dial-options-2col.json",
        "TriggerDescription": { "Rotate": "Navigate / Adjust", "Push": "Toggle edit", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-ssb-options",
      "Name": "Deck RX SSB Options",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "USB / LSB / CW options: BW + BFO + Gain (active only when demod is mode 4 / 5 / 6)",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "SSB" }],
      "Encoder": {
        "layout": "layouts/dial-ssb-options.json",
        "TriggerDescription": { "Rotate": "Navigate / Adjust", "Push": "Toggle edit", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-volume",
      "Name": "Deck RX Volume",
      "Icon": "imgs/actions/volume/action",
      "Tooltip": "Audio volume / mute + connection status",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/volume/action", "Title": "Vol" }],
      "Encoder": {
        "layout": "layouts/dial-volume.json",
        "TriggerDescription": { "Rotate": "Adjust volume", "Push": "Toggle mute", "LongTouch": "" }
      }
    },
    {
      "UUID": "com.hogehoge.deck-rx.dial-fft",
      "Name": "Deck RX FFT Display",
      "Icon": "imgs/actions/options/action",
      "Tooltip": "Real-time SDR++-style FFT spectrum centered on the current VFO",
      "PropertyInspectorPath": "ui/dial-fft/inspector.html",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/actions/options/action", "Title": "FFT" }],
      "Encoder": {
        "layout": "layouts/dial-fft.json",
        "TriggerDescription": { "Rotate": "Zoom (active axis)", "Push": "Reset zoom / Long-press: H↔V", "LongTouch": "" }
      }
    }
  ],
  "OS": [{ "Platform": "mac", "MinimumVersion": "10.15" }],
  "Software": { "MinimumVersion": "6.6" },
  "SDKVersion": 2,
  "Nodejs": { "Version": "20", "Debug": "enabled" }
}
