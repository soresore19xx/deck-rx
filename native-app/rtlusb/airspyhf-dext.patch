+
+kern_return_t
+RTL_SDR::HandleControl(const void *setupp, uint32_t setupLength,
+                       void *data, uint32_t dataCapacity, uint32_t *transferred)
+{
+    if (transferred)
+        *transferred = 0;
+    RTLSDRTransport *t = (ivars ? ivars->t : nullptr);
+    if (!t || !t->deviceQueue || !t->usbAttached)
+        return kIOReturnNotReady;
+    if (!setupp || setupLength < sizeof(RTLSDRControlSetup))
+        return kIOReturnBadArgument;
+
+    RTLSDRControlSetup s;
+    memcpy(&s, setupp, sizeof(s));
+    const bool isIn = (s.bmRequestType & 0x80u) != 0;
+    if (s.wLength > RTLSDR_CONTROL_MAX_DATA)
+        return kIOReturnBadArgument;
+    if (isIn && s.wLength > dataCapacity)
+        return kIOReturnBadArgument;
+    if (!isIn && setupLength < sizeof(s) + s.wLength)
+        return kIOReturnBadArgument;
+
+    /* OUT data follows the setup; IN data comes back in `data`. */
+    void *buf = isIn ? data : (void *)((const uint8_t *)setupp + sizeof(s));
+    __block int32_t  ret = 0;
+    __block uint16_t got = 0;
+    t->deviceQueue->DispatchSync(^{
+        ret = usb_driverkit_control(s.bmRequestType, s.bRequest, s.wValue, s.wIndex,
+                                    buf, s.wLength, s.timeoutMs ? s.timeoutMs : 1000, &got);
+    });
+    if (RTLSDR_LOG_COMMANDS)
+        os_log(OS_LOG_DEFAULT, "[rtlsdr] ControlTransfer(%02x %02x %04x %04x %u) -> 0x%x, %u",
+               s.bmRequestType, s.bRequest, s.wValue, s.wIndex, s.wLength, ret, got);
+    if (transferred)
+        *transferred = got;
+    return ret;
+}
diff --git a/RTL-SDR/RTL_SDR.iig b/RTL-SDR/RTL_SDR.iig
index 5ff8d35..3cb5bda 100644
--- a/RTL-SDR/RTL_SDR.iig
+++ b/RTL-SDR/RTL_SDR.iig
@@ -70,6 +70,16 @@ public:
     //  Fills an RTLSDRDeviceInfo struct (passed as void* to keep iig simple).
     virtual kern_return_t
     FillDeviceInfo(void * info) LOCALONLY;
+
+    //  A raw control transfer (kRTLSDRMethodControlTransfer), serialised on
+    //  the device dispatch queue. `setup` is an RTLSDRControlSetup followed by
+    //  the OUT data; IN data lands in `data`.
+    virtual kern_return_t
+    HandleControl(const void * setup,
+                  uint32_t     setupLength,
+                  void *       data,
+                  uint32_t     dataCapacity,
+                  uint32_t *   transferred) LOCALONLY;
     
     
 };
diff --git a/RTL-SDR/RTL_SDR_UserClient.cpp b/RTL-SDR/RTL_SDR_UserClient.cpp
index 09a901d..0c3becc 100644
--- a/RTL-SDR/RTL_SDR_UserClient.cpp
+++ b/RTL-SDR/RTL_SDR_UserClient.cpp
@@ -123,6 +123,29 @@ RTL_SDR_UserClient::ExternalMethod(uint64_t selector,
                    ? kIOReturnSuccess : kIOReturnNoMemory;
     }
 
+    //  A raw control transfer: setup (+ OUT data) in, IN data out.
+    if (selector == kRTLSDRMethodControlTransfer) {
+        if (!arguments || !arguments->structureInput)
+            return kIOReturnBadArgument;
+        OSData *in = arguments->structureInput;
+        uint8_t *inData = (uint8_t *)IOMalloc(RTLSDR_CONTROL_MAX_DATA);
+        if (!inData)
+            return kIOReturnNoMemory;
+        uint32_t got = 0;
+        kern_return_t ret = ivars->owner->HandleControl(in->getBytesNoCopy(),
+                                                        (uint32_t)in->getLength(),
+                                                        inData, RTLSDR_CONTROL_MAX_DATA,
+                                                        &got);
+        if (ret == kIOReturnSuccess && got > 0)
+            arguments->structureOutput = OSData::withBytes(inData, got);
+        IOFree(inData, RTLSDR_CONTROL_MAX_DATA);
+        if (arguments->scalarOutput && arguments->scalarOutputCount > 0) {
+            arguments->scalarOutput[0]   = got;
+            arguments->scalarOutputCount = 1;
+        }
+        return ret;
+    }
+
     //  Everything else is a scalar command (selectors 0 .. GetTunerType).
     if (selector >= kRTLSDRMethodCount)
         return kIOReturnBadArgument;
diff --git a/RTL-SDR/include/RTLSDRShared.h b/RTL-SDR/include/RTLSDRShared.h
index a60a419..aa3e28a 100644
--- a/RTL-SDR/include/RTLSDRShared.h
+++ b/RTL-SDR/include/RTLSDRShared.h
@@ -62,6 +62,12 @@ enum {
     kRTLSDRMethodGetTunerType      = 14, /* scalarOutput[0] = enum rtlsdr_tuner       */
     kRTLSDRMethodGetDeviceInfo     = 15, /* structOutput   = RTLSDRDeviceInfo         */
     kRTLSDRMethodSetOffsetTuning   = 16, /* scalarInput[0] = 1 on / 0 off             */
+    /* Raw USB, for devices the dext streams but does not program itself
+     * (the Airspy HF+: libairspyhf runs in the app). */
+    kRTLSDRMethodControlTransfer   = 17, /* structInput = RTLSDRControlSetup + OUT data,
+                                            structOutput = IN data,
+                                            scalarOutput[0] = bytes transferred      */
+    kRTLSDRMethodClearHalt         = 18, /* clears the IQ endpoint (stream stopped)  */
     kRTLSDRMethodCount
 };
 
@@ -106,6 +112,27 @@ typedef struct RTLSDRDeviceInfo {
     char     product[256];
     char     dextVersion[32];       /* "1.0 (7)": version (build) of the     */
                                     /* running dext, empty from older dexts */
+    uint16_t idVendor;              /* the USB device this service drives    */
+    uint16_t idProduct;
 } RTLSDRDeviceInfo;
 
+/* ---------------------------------------------------------------------------
+ * kRTLSDRMethodControlTransfer: the setup, then wLength bytes of data for an
+ * OUT request. An IN request returns its data as the structure output.
+ * ------------------------------------------------------------------------- */
+typedef struct RTLSDRControlSetup {
+    uint8_t  bmRequestType;
+    uint8_t  bRequest;
+    uint16_t wValue;
+    uint16_t wIndex;
+    uint16_t wLength;
+    uint32_t timeoutMs;
+} RTLSDRControlSetup;
+
+#define RTLSDR_CONTROL_MAX_DATA 4096u
+
+/* The Airspy HF+, which the same dext streams. */
+#define RTLSDR_AIRSPYHF_VID 0x03EBu
+#define RTLSDR_AIRSPYHF_PID 0x800Cu
+
 #endif /* RTLSDR_SHARED_H */
