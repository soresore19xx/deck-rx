+    if (!t || (!t->radio && !t->airspy))
         return kIOReturnNotReady;
 
     info->valid      = 1;
-    info->tunerType  = RTL2832Radio_GetTunerType(t->radio);
-    info->sampleRate = RTL2832Radio_GetSampleRate(t->radio);
+    info->tunerType  = t->radio ? RTL2832Radio_GetTunerType(t->radio) : 0u;
+    info->sampleRate = t->radio ? RTL2832Radio_GetSampleRate(t->radio) : 0u;
+    info->idVendor   = t->idVendor;
+    info->idProduct  = t->idProduct;
     info->streaming  = RTLSDR_IsStreaming(t) ? 1u : 0u;
